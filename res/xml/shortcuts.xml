<?xml version="1.0" encoding="utf-8"?>
<shortcuts
    xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:icon="@drawable/shortcut_search"
        android:enabled="true"
        android:shortcutId="search"
        android:shortcutShortLabel="@string/search">
        <intent
            android:targetPackage="app.miyu.my.id"
            android:action="com.metrolist.music.action.SEARCH"
            android:targetClass="com.metrolist.music.MainActivity" />
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_library"
        android:enabled="true"
        android:shortcutId="library"
        android:shortcutShortLabel="@string/filter_library">
        <intent
            android:targetPackage="app.miyu.my.id"
            android:action="com.metrolist.music.action.LIBRARY"
            android:targetClass="com.metrolist.music.MainActivity" />
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_library"
        android:enabled="true"
        android:shortcutId="miyu_profile"
        android:shortcutShortLabel="@string/miyu_profile_title"
        android:shortcutLongLabel="@string/miyu_profile_open">
        <intent
            android:targetPackage="app.miyu.my.id"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.metrolist.music.ui.screens.MiyuProfileActivity" />
    </shortcut>
    <shortcut
        android:icon="@drawable/shortcut_library"
        android:enabled="true"
        android:shortcutId="miyu_level"
        android:shortcutShortLabel="@string/miyu_profile_level">
        <intent
            android:targetPackage="app.miyu.my.id"
            android:action="android.intent.action.MAIN"
            android:targetClass="com.metrolist.music.ui.screens.MiyuProfileActivity" />
    </shortcut>
</shortcuts>